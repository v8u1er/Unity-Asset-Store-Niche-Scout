// Project config for Niche Scout. Place at the project root (next to pyproject.toml).
// Rules are evaluated top to bottom and the LAST matching rule wins,
// so broad defaults come first and exceptions after them.
//
// Do NOT put API keys or {env:...} references in this file; project config
// cannot resolve them (by design). Credentials stay in the global config.
//
// Tuned for autonomous runs: routine, non-destructive commands are allowed so
// subagents do not stall on prompts. Pattern rules are guardrails, not a
// sandbox (e.g. `python -c` can do anything). The real safety net is the
// per-chunk git branch, the independent reviewer, and keeping live
// credentials out of the project while agents run.
{
  "$schema": "https://app.kilo.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",

      // Project secrets (Coveo bearer token, Unity CSRF token). LREQ-SEC-020.
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      // Kilo skips node_modules/dist/build/.git/__pycache__ on its own,
      // but NOT these. Keep grep/glob out of them.
      ".venv/**": "deny",
      "venv/**": "deny",
      ".pytest_cache/**": "deny",
      ".ruff_cache/**": "deny",
      ".mypy_cache/**": "deny",
      "**/*.egg-info/**": "deny",

      // SQLite run databases are binary; agents read schema/code instead.
      "*.db": "deny",
      "*.sqlite": "deny",
      "*.sqlite3": "deny"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      // The spec is the source of truth. Any edit needs your approval.
      "Documents/SRS-lean.md": "ask",
      "Documents/requirements-dependency-map.md": "ask",

      // Agents must not rewrite their own permissions or prompts.
      "kilo.jsonc": "deny",
      ".kilo/**": "deny"
    },

    "bash": {
      "*": "ask",

      // ---- Routine work: run freely -----------------------------------
      "python *": "allow",
      "py *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "pip list*": "allow",
      "pip show*": "allow",
      "pip install -e *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "Get-ChildItem*": "allow",
      "Test-Path*": "allow",
      "mkdir *": "allow",

      // ---- Ask (must come AFTER the broad allows above) ---------------
      "python -m pip *": "ask",
      "pip install *": "ask",
      "pip install -e *": "allow",
      "rm *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "rd *": "ask",
      "Remove-Item *": "ask",
      "git add *": "ask",
      "git commit *": "ask",

      // ---- Never from an agent ----------------------------------------
      "git push *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",

      // A real run hits live Coveo/GraphQL endpoints with your credentials.
      // Run it yourself in a terminal; agents work against fixtures only.
      "niche-scout run*": "deny",
      "python -m niche_scout* run*": "deny"
    },

    "webfetch": "ask",
    "websearch": "ask"
  },

  "watcher": {
    "ignore": [
      ".venv/**",
      "venv/**",
      "**/__pycache__/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      ".mypy_cache/**",
      "*.db",
      "*.sqlite",
      "*.sqlite3"
    ]
  }
}
