  "cards": [
    {
      "dot": "cyan",
      "title": "Discovery",
      "items": [
        "One Coveo POST per category page, bearer-authorized; free-text q/query rejected",
        "Request body replayed from config/coveo_search_template.json; taxonomy must be fresh before any transport call"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sampling & scoring",
      "items": [
        "Deterministic parallelism-by-stride strata selection; no RNG",
        "Pure core (metrics, scoring, validation, sampling): no clock reads, no I/O; models.py holds typed records + frozen constants"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence",
      "items": [
        "SQLite runtime/niche_scout.sqlite3: runs, raw_discovery_observations, sample_members, enrichment_observations, category_scores",
        "Audit rows persisted before scoring; scoring cut-off captured once"
      ]
    },
    {
      "dot": "rose",
      "title": "Reporting & gates",
      "items": [
        "run --report writes a self-contained HTML/text report; dashboard serves persisted rows on loopback",
        "tools/: traceability + import-boundary + secrets checks gate the build"
      ]
    }
  ]
